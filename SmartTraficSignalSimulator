
import pygame
import random

# Initialize Pygame
pygame.init()

# Constants
SCREEN_WIDTH = 600
SCREEN_HEIGHT = 400
CAR_SPEED = 3

# Custom event IDs
CAR_COLOR_CHANGE_EVENT = pygame.USEREVENT + 1
SIGNAL_CHANGE_EVENT = pygame.USEREVENT + 2

# Define colours
ROAD = pygame.Color("darkgray")
WHITE = pygame.Color("white")
YELLOW = pygame.Color("yellow")
BLUE = pygame.Color("blue")
ORANGE = pygame.Color("orange")

RED = pygame.Color("red")
GREEN = pygame.Color("green")


# Create a Car sprite class
class Car(pygame.sprite.Sprite):

    def __init__(self, color, width, height):
        super().__init__()

        # Create the car image
        self.image = pygame.Surface([width, height])
        self.image.fill(color)

        # Create the car Rect
        self.rect = self.image.get_rect()

        # Set the car velocity
        self.velocity = [CAR_SPEED, 0]

    # Update the car's position
    def update(self):

        # Move the car
        self.rect.move_ip(self.velocity)

        sensor_triggered = False

        # Check the road boundaries
        if self.rect.left <= 0:

            self.rect.left = 0
            self.velocity[0] = abs(self.velocity[0])

            sensor_triggered = True

        elif self.rect.right >= SCREEN_WIDTH:

            self.rect.right = SCREEN_WIDTH
            self.velocity[0] = -abs(self.velocity[0])

            sensor_triggered = True

        # Post custom events when a boundary is reached
        if sensor_triggered:

            pygame.event.post(
                pygame.event.Event(CAR_COLOR_CHANGE_EVENT)
            )

            pygame.event.post(
                pygame.event.Event(SIGNAL_CHANGE_EVENT)
            )

    # Change the car's colour
    def change_color(self):

        self.image.fill(
            random.choice([WHITE, YELLOW, BLUE, ORANGE])
        )


# Function to change the traffic signal
def change_signal():

    global signal_color

    if signal_color == RED:
        signal_color = GREEN
    else:
        signal_color = RED


# Create the game window
screen = pygame.display.set_mode(
    (SCREEN_WIDTH, SCREEN_HEIGHT)
)

pygame.display.set_caption(
    "Smart Traffic Signal Simulator"
)

# Create a sprite group
all_sprites = pygame.sprite.Group()

# Create the car
car = Car(WHITE, 70, 35)

car.rect.x = 50
car.rect.y = 300

# Add the car to the sprite group
all_sprites.add(car)

# Starting traffic signal colour
signal_color = RED

# Create a clock
clock = pygame.time.Clock()

# Main game loop
running = True

while running:

    # Handle events
    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        # Handle car colour change event
        elif event.type == CAR_COLOR_CHANGE_EVENT:
            car.change_color()

        # Handle traffic signal change event
        elif event.type == SIGNAL_CHANGE_EVENT:
            change_signal()

    # Update all sprites
    all_sprites.update()

    # Draw the road background
    screen.fill(ROAD)

    # Draw road divider lines
    for x in range(0, SCREEN_WIDTH, 80):

        pygame.draw.rect(
            screen,
            WHITE,
            (x, 345, 45, 5)
        )

    # Draw the traffic signal box
    pygame.draw.rect(
        screen,
        pygame.Color("black"),
        (275, 40, 50, 90)
    )

    # Draw the active traffic signal
    pygame.draw.circle(
        screen,
        signal_color,
        (300, 85),
        20
    )

    # Update and draw the car
    all_sprites.draw(screen)

    # Refresh the display
    pygame.display.flip()

    # Limit the frame rate
    clock.tick(60)

# Close Pygame
pygame.quit()
